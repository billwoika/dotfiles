# ~/development/work/mise.toml
# ─────────────────────────────────────────────────────────────────────
# Work profile defaults. mise walks UP the directory tree, so this applies
# to every repo under ~/development/work/ and merges with the user-scope
# config at ~/.config/mise/config.toml.
#
# Merge semantics: [tools] and [env] are additive-with-override (the
# closer file wins per key). [tasks] are REPLACED WHOLE per task name.
#
# SETUP: bootstrap.sh copies this to ~/development/work/mise.toml (dropping
# the .example suffix). It is a SEED — edit it in place. It is deliberately
# NOT in [dotfiles], so it drifts locally without mise converging it back,
# and work-specific tooling never lands in this public repo.
#
# Needs `mise trust` on first use.
# ─────────────────────────────────────────────────────────────────────

[env]
DEV_PROFILE = "work"

[tools]
# Work-only tools go here, e.g.:
# terraform = "1.9"
