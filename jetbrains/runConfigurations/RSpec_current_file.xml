<!--
  Reference RSpec run configuration for RubyMine.
  Place at .idea/runConfigurations/RSpec_current_file.xml in a Rails/RSpec project.

  This config runs RSpec against whatever spec file is currently open.
  The IDE provides a $FilePath$ macro that resolves to the active editor's
  file when the config is invoked.

  After committing this file, every engineer on the team has the same
  "Run RSpec on current spec file" entry in their Run Configuration
  dropdown — no per-developer setup required.
-->
<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="RSpec: current file" type="RSpecRunConfigurationType" factoryName="RSpec">
    <module name="" />
    <predefined_log_file enabled="true" id="RUBY_RSPEC" />
    <RUBY_RUN_CONFIG NAME="RUBY_ARGS" VALUE="" />
    <RUBY_RUN_CONFIG NAME="WORK DIR" VALUE="$PROJECT_DIR$" />
    <RUBY_RUN_CONFIG NAME="SHOULD_USE_SDK" VALUE="false" />
    <RUBY_RUN_CONFIG NAME="ALTERN_SDK_NAME" VALUE="" />
    <RUBY_RUN_CONFIG NAME="myPassParentEnvs" VALUE="true" />
    <COVERAGE_PATTERN ENABLED="true" REGEXP="false" PATTERN="lib/*" />
    <COVERAGE_PATTERN ENABLED="true" REGEXP="false" PATTERN="app/*" />
    <RSPEC_RUN_CONFIG NAME="RSPEC_RUN_TYPE" VALUE="0" />
    <RSPEC_RUN_CONFIG NAME="RSPEC_RUNNER_OPTIONS" VALUE="--format documentation" />
    <RSPEC_RUN_CONFIG NAME="RSPEC_EXAMPLE_NAME" VALUE="" />
    <RSPEC_RUN_CONFIG NAME="USE_CUSTOM_SPEC_RUNNER" VALUE="false" />
    <RSPEC_RUN_CONFIG NAME="CUSTOM_SPEC_RUNNER" VALUE="" />
    <RSPEC_RUN_CONFIG NAME="SPEC_FILE_PATH" VALUE="$FilePath$" />
    <method v="2" />
  </configuration>
</component>
