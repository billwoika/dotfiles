<!--
  Reference pytest run configuration for PyCharm.
  Place at .idea/runConfigurations/Pytest_current_file.xml in a Python project.

  This config runs pytest against whatever test file is currently open,
  using the project's mise/uv-managed Python interpreter.

  Adjust SDK_NAME and INTERPRETER_OPTIONS to match your project's
  Python setup. The framework's recommendation is to point at the mise
  shim path (~/.local/share/mise/shims/python) so version resolution
  honors mise.toml — see Section 22.5.2.
-->
<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="pytest: current file" type="tests" factoryName="py.test">
    <module name="" />
    <option name="INTERPRETER_OPTIONS" value="" />
    <option name="PARENT_ENVS" value="true" />
    <envs>
      <env name="PYTHONUNBUFFERED" value="1" />
    </envs>
    <option name="SDK_HOME" value="" />
    <option name="WORKING_DIRECTORY" value="$PROJECT_DIR$" />
    <option name="IS_MODULE_SDK" value="true" />
    <option name="ADD_CONTENT_ROOTS" value="true" />
    <option name="ADD_SOURCE_ROOTS" value="true" />
    <EXTENSION ID="PythonCoverageRunConfigurationExtension" runner="coverage.py" />
    <option name="_new_keywords" value="&quot;&quot;" />
    <option name="_new_parameters" value="&quot;-v&quot;" />
    <option name="_new_additionalArguments" value="&quot;&quot;" />
    <option name="_new_target" value="&quot;$FilePath$&quot;" />
    <option name="_new_targetType" value="&quot;PATH&quot;" />
    <method v="2" />
  </configuration>
</component>
