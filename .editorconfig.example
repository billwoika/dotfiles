# .editorconfig
# ─────────────────────────────────────────────────────────────────────
# Reference template for projects following this framework.
# Copy to <project>/.editorconfig.
#
# https://editorconfig.org
# ─────────────────────────────────────────────────────────────────────

root = true

[*]
charset                  = utf-8
end_of_line              = lf
insert_final_newline     = true
trim_trailing_whitespace = true
indent_style             = space
indent_size              = 2

# Common code: 2-space indent
[*.{rb,py,go,rs,kt,swift}]
indent_size = 2

[*.{js,jsx,ts,tsx,vue,svelte}]
indent_size = 2

[*.{yml,yaml,toml,json,jsonc}]
indent_size = 2

# Markdown: trailing whitespace can be meaningful (line breaks)
[*.md]
trim_trailing_whitespace = false

# Makefiles MUST use real tabs (Section 7.2)
[Makefile]
indent_style = tab

# Shell scripts: 2-space indent
[*.{sh,bash,zsh}]
indent_style = space
indent_size  = 2

# Windows-only files keep CRLF endings
[*.{bat,ps1}]
end_of_line = crlf
